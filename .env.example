# Copy this file to ".env" and fill it in. Never share .env.
# Gnani AI does all the voice work. Without GNANI_API_KEY it runs in demo mode (you type answers).

# Gnani AI key: https://app.gnani.ai/voice -> API keys
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
# Timbre v3.0 voices speak all 10 languages. The call lines are written for a female voice:
# Chetana, Kalpana, Shivani, Lakshmi, Vasudha, Riyaa, Tarika
GNANI_DEFAULT_VOICE=Chetana
# Slower speech for elders: 0.85 (slowest) .. 1.15
GNANI_TTS_SPEED=0.9

# Weekly health-trend report written by AI (optional; without a key a rules-based report is shown).
# Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ...or Anthropic instead
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Protects the family page when others can reach your server. Username is "family".
DASHBOARD_PASSWORD=
TIMEZONE=Asia/Kolkata
